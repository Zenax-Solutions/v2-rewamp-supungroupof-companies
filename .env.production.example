# Production Environment Configuration
# Copy this to .env on your production server and update the values

# Server Configuration
PORT=3001
NODE_ENV=production

# Frontend API URL - IMPORTANT: Change this to your actual domain!
# This tells the frontend where to find your backend API
VITE_API_URL=https://your-domain.com/api

# JWT Secret - IMPORTANT: Generate a secure random string!
# Run: openssl rand -base64 32
JWT_SECRET=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-IN-PRODUCTION

# Database
DATABASE_PATH=/var/www/supungroup/server/database.sqlite

# Upload Configuration (10MB for images and PDFs)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/var/www/supungroup/server/uploads

# CORS Configuration (optional)
# CORS_ORIGIN=https://your-domain.com

# Security (optional)
# RATE_LIMIT_WINDOW=15
# RATE_LIMIT_MAX_REQUESTS=100
